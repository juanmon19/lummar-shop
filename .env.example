# ==========================================================
# VARIABLES DE ENTORNO PARA VERCEL - LUMMAR SHOP MVC
# ==========================================================

# 1. Base de Datos PostgreSQL (Neon / Vercel Postgres / Supabase)
DATABASE_URL="postgresql://usuario:password@ep-ejemplo.us-east-2.aws.neon.tech/lummar_shop?sslmode=require"

# 2. Seguridad JWT y NextAuth (Genera una clave aleatoria de 32+ caracteres)
NEXTAUTH_SECRET="clave_secreta_super_segura_lummar_shop_2026_jwt"
NEXTAUTH_URL="http://localhost:3000"
JWT_SECRET="clave_secreta_para_firmar_cookies_httponly_2026"

# 3. Credenciales Google OAuth 2.0 (Google Cloud Console)
GOOGLE_CLIENT_ID="tu_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="tu_client_secret"

# 4. Correos de Google autorizados para ser Administradores automáticamente
ADMIN_EMAILS="tu_correo@gmail.com"

# 5. Número de WhatsApp para recibir pedidos (Código de país + número)
NEXT_PUBLIC_WHATSAPP_NUMBER="57 310 5801620"
