# ==========================================================
# VARIABLES DE ENTORNO - LUMMAR SHOP (Next.js + PostgreSQL)
# Copia este archivo como .env.local para desarrollo.
# En Vercel, agrégalas en Settings > Environment Variables.
# ==========================================================

# 1. Base de datos PostgreSQL (Neon, Supabase o Vercel Marketplace)
# Neon: https://neon.tech  |  Supabase: https://supabase.com
DATABASE_URL="postgresql://usuario:password@ep-ejemplo.us-east-2.aws.neon.tech/lummar_shop?sslmode=require"
DATABASE_SSL="true"
DATABASE_POOL_MAX="5"

# 2. Configuración inicial (página /setup)
# Inventa una clave larga y privada. Después de crear el admin puedes borrarla.
SETUP_SECRET="cambia_esta_clave_por_una_larga_y_privada_2026"

# 3. Seguridad JWT y NextAuth
# Genera valores aleatorios de 32+ caracteres.
NEXTAUTH_SECRET="cambia_esto_por_una_clave_aleatoria_larga"
NEXTAUTH_URL="http://localhost:3000"
JWT_SECRET="cambia_esto_por_otra_clave_aleatoria_larga"

# 4. Google OAuth 2.0 (opcional)
# Si no lo configuras, usa /setup para crear el administrador con correo y contraseña.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Correos de Google autorizados como administradores (separados por coma).
# Si lo dejas vacío, solo se permite registrar el primer usuario.
ADMIN_EMAILS=""

# 5. WhatsApp para recibir pedidos
# Código de país + número, sin espacios ni símbolos. Ejemplo Colombia: 573105801620
NEXT_PUBLIC_WHATSAPP_NUMBER="573105801620"

# 6. Opcional: permitir registro de admin sin Google.
# Déjalo en false salvo que sepas lo que haces.
ALLOW_PASSWORD_SIGNUP="false"
